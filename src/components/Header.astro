---
import { nav } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <Logo size={44} />
      <span class="wordmark">Wrench <span>&amp;</span> Level</span>
    </a>

    <nav class="desktop-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn btn-accent book" href="/book">Book Now</a>
    </nav>

    <div class="phone-actions">
      <a class="btn btn-accent book" href="/book">Book</a>
      <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="phone-menu">
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>

  <!-- Phone nav: slide-down menu with the 4 pages + Book. -->
  <nav id="phone-menu" class="phone-menu" aria-label="Main">
    <div class="container">
      {nav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn btn-accent" href="/book">Book a time</a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('menu-open', open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--charcoal);
    color: var(--ground);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ground);
    text-decoration: none;
  }

  .brand :global(svg) {
    width: 36px;
    height: 36px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .wordmark span {
    color: var(--accent);
  }

  .desktop-nav {
    display: none;
  }

  .phone-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .book {
    min-height: 44px;
    padding: 0 16px;
    font-size: 16px;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ground);
    cursor: pointer;
  }

  .menu-toggle :global(.icon-close),
  .menu-open .menu-toggle :global(.icon-open) {
    display: none;
  }

  .menu-open .menu-toggle :global(.icon-close) {
    display: block;
  }

  .phone-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.2s ease;
  }

  .phone-menu > .container {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .menu-open .phone-menu {
    grid-template-rows: 1fr;
  }

  .menu-open .phone-menu > .container {
    padding-bottom: 20px;
  }

  .site-header:not(.menu-open) .phone-menu a {
    visibility: hidden;
  }

  .phone-menu a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid #2c2f33;
    color: var(--ground);
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
  }

  .phone-menu a[aria-current='page'] {
    color: var(--accent);
  }

  .phone-menu .btn {
    margin-top: 16px;
  }

  @media (min-width: 768px) {
    .bar {
      min-height: 96px;
    }

    .brand {
      gap: 12px;
    }

    .brand :global(svg) {
      width: 44px;
      height: 44px;
    }

    .wordmark {
      font-size: 28px;
      letter-spacing: 1.5px;
    }

    .phone-actions,
    .phone-menu {
      display: none;
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 36px;
      font-size: 17px;
      font-weight: 500;
    }

    .desktop-nav a:not(.btn) {
      padding: 6px 0;
      border-bottom: 3px solid transparent;
      color: var(--ground);
      text-decoration: none;
    }

    .desktop-nav a:not(.btn):hover {
      border-bottom-color: var(--outline-dark);
    }

    .desktop-nav a[aria-current='page'] {
      border-bottom-color: var(--accent);
    }

    .book {
      min-height: 48px;
      padding: 0 24px;
      font-size: 17px;
    }
  }

  @media (min-width: 768px) and (max-width: 1099px) {
    .desktop-nav {
      gap: 20px;
      font-size: 16px;
    }

    .wordmark {
      font-size: 22px;
    }
  }
</style>
