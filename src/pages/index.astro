---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { photos, reviews, site } from '../data/site';
import { addOn, basePrice, markup, money, tierRange } from '../lib/prices';

const tv = basePrice('tv-mounting');
const furniture = tierRange('furniture-assembly');
const showHeroPhoto = Boolean(photos.hero) || import.meta.env.DEV;

const home = [
  ['TV mounting (drywall, your bracket)', money(tv)],
  ['Hide cords in the wall', `+${money(addOn('tv-mounting', 'hide-cords'))}`],
  ['Shelves, art, mirrors, curtain rods', `from ${money(basePrice('hanging'))}`],
  ['Furniture assembly', `${money(furniture.min)} to ${money(furniture.max)}`],
  ['Odd jobs', `${money(basePrice('odd-jobs'))}/hr`],
];

const auto = [
  ['Brake pads, per axle', money(basePrice('brake-pads-1-axle'))],
  ['Pads + rotors, per axle', money(basePrice('pads-rotors-1-axle'))],
  ['Both axles, pads + rotors', money(basePrice('pads-rotors-both-axles'))],
  ['Add an oil change to any brake job', `+${money(addOn('brake-pads-1-axle', 'oil-change'))}`],
  ['Parts matched to your VIN', markup],
];

const steps = [
  ['Pick your service', 'Choose from home or auto. Add photos or your VIN so I come prepared.'],
  ['Grab a time', 'Evening and weekend slots, booked online. You get a text reminder before I head over.'],
  [
    "Pay when it's done",
    "No deposits. Venmo, Cash App, card or cash once you're happy. Find a bigger problem than you booked? You don't pay for the visit.",
  ],
];

const trust = [
  { icon: 'tag', title: 'Flat, posted prices', text: 'You know the cost before I show up.' },
  { icon: 'level', title: 'Pro install experience', text: 'Level, anchored and solid the first time.' },
  { icon: 'shield', title: '90-day guarantee', text: "Something I did isn't right? I come back free." },
  { icon: 'clock', title: 'After-hours friendly', text: 'Evenings and weekends, no time off needed.' },
] as const;
---

<Base title="Home">
  <section class="dark hero">
    <div class:list={['container', showHeroPhoto && 'hero-grid']}>
      <div class="stack hero-copy">
        <div class="eyebrow">{site.area} area · Evenings and weekends</div>
        <h1 class="h1">{site.tagline}</h1>
        <p class="lead">
          TV mounting, shelves, furniture assembly and brake jobs. Flat rates, my own tools, and a 90-day guarantee on
          the work.
        </p>
        <div class="btn-row">
          <a class="btn btn-accent" href="/book">Book a time</a>
          <a class="btn btn-outline" href="#prices">See prices</a>
        </div>
      </div>

      {showHeroPhoto && (
        <div class="hero-photo">
          {photos.hero ? (
            <div class="media">
              <img src={photos.hero} alt="A recent Wrench & Level job" />
            </div>
          ) : (
            <div class="media placeholder">[PHOTO: a clean TV install or brake job you did]</div>
          )}
          <div class="badge">
            <span>TV mounting from</span>
            <strong>{money(tv)}</strong>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section" id="prices">
    <div class="container stack lanes">
      <div class="stack" style="gap: 8px">
        <div class="eyebrow">Two lanes, one call</div>
        <h2 class="h2">What I can help with</h2>
      </div>

      <div class="grid-2">
        {[
          { title: 'Home', icon: 'home', rows: home, href: '/home-services', link: 'See all home services' },
          { title: 'Auto', icon: 'car', rows: auto, href: '/auto-services', link: 'See all auto services' },
        ].map((lane) => (
          <div class="card lane">
            <div class="lane-head">
              <div class="lane-icon">
                <Icon name={lane.icon as 'home' | 'car'} size={28} />
              </div>
              <h3 class="h3-display">{lane.title}</h3>
            </div>
            <div class="rows">
              {lane.rows.map(([label, price]) => (
                <div>
                  <span>{label}</span>
                  <span>{price}</span>
                </div>
              ))}
            </div>
            <a class="text-link" href={lane.href}>{lane.link}</a>
          </div>
        ))}
      </div>
      <p class="muted">Labor only. Bring your own parts, or I'll grab them at cost.</p>
    </div>
  </section>

  <section class="section how">
    <div class="container stack">
      <h2 class="h2">How it works</h2>
      <div class="grid-3">
        {steps.map(([title, text], i) => (
          <div class="step">
            <span class="step-num">0{i + 1}</span>
            <h3 class="h3">{title}</h3>
            <p class="body-lg muted">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="dark trust">
    <div class="container trust-grid">
      {trust.map((t) => (
        <div class="trust-item">
          <Icon name={t.icon} size={32} class="trust-icon" />
          <span class="trust-title">{t.title}</span>
          <span class="muted">{t.text}</span>
        </div>
      ))}
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="section">
      <div class="container stack">
        <h2 class="h2">What neighbors say</h2>
        <div class="grid-3">
          {reviews.map((r) => (
            <figure class="card review">
              <blockquote>{r.quote}</blockquote>
              <figcaption class="muted">{r.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class:list={[reviews.length === 0 && 'cta-gap']}>
    <CtaBand
      title="Got a project that keeps getting pushed off?"
      text="Bundle a few things into one visit and save."
    />
  </div>
</Base>

<style>
  .hero {
    padding: 40px 0 48px;
  }

  .hero-copy {
    gap: 22px;
  }

  .hero-grid {
    display: grid;
    gap: 32px;
  }

  .hero-photo {
    position: relative;
    margin-bottom: 20px;
  }

  .badge {
    position: absolute;
    left: 16px;
    bottom: -20px;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    border-radius: 8px;
    background: var(--ground);
    color: var(--ink);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .badge span {
    font-size: 13px;
    color: var(--muted);
  }

  .badge strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    line-height: 1.1;
  }

  .lanes {
    gap: 24px;
  }

  .lane {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .lane-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lane-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: var(--charcoal);
    color: var(--accent);
  }

  .lane-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .lanes > .muted {
    font-size: 15px;
  }

  .how {
    padding-top: 0;
  }

  .how .stack {
    gap: 28px;
  }

  .trust {
    padding: 40px 0;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 20px;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.45;
  }

  .trust-item :global(.trust-icon) {
    width: 28px;
    height: 28px;
    color: var(--accent);
  }

  .trust-title {
    font-size: 18px;
    font-weight: 600;
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }

  .review blockquote {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
  }

  .cta-gap {
    padding-top: var(--section-y);
  }

  @media (min-width: 768px) {
    .hero {
      padding: 96px 0;
    }

    .hero-copy {
      gap: 28px;
    }

    .hero-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 64px;
      align-items: center;
    }

    .hero-photo {
      margin-bottom: 0;
    }

    .hero-photo .media {
      height: 480px;
    }

    .badge {
      left: -24px;
      bottom: 32px;
      gap: 2px;
      padding: 16px 20px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    }

    .badge span {
      font-size: 14px;
    }

    .badge strong {
      font-size: 36px;
    }

    .section#prices {
      padding: 112px 0;
    }

    .lanes {
      gap: 48px;
    }

    .lane {
      gap: 24px;
      padding: 40px;
    }

    .lane-head {
      gap: 16px;
    }

    .lane-icon {
      width: 56px;
      height: 56px;
      border-radius: 10px;
    }

    .lane-icon :global(svg) {
      width: 28px;
      height: 28px;
    }

    .lanes > .muted {
      font-size: 16px;
    }

    .how {
      padding-bottom: 112px;
    }

    .how .stack {
      gap: 48px;
    }

    .trust {
      padding: 64px 0;
    }

    .trust-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px;
    }

    .trust-item {
      gap: 12px;
      font-size: 16px;
      line-height: 1.5;
    }

    .trust-item :global(.trust-icon) {
      width: 32px;
      height: 32px;
    }

    .trust-title {
      font-size: 22px;
    }

    .review {
      gap: 20px;
      padding: 32px;
    }

    .review blockquote {
      font-size: 20px;
    }

    .cta-gap {
      padding-top: 112px;
    }
  }
</style>
