---
import { nav, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container cols">
    <div class="col">
      <span class="wordmark">Wrench <span>&amp;</span> Level</span>
      <span>{site.tagline}</span>
    </div>

    <div class="col">
      <span class="label">Service area</span>
      <span>{site.area} and surrounding area</span>
      {site.phone && <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a>}
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
    </div>

    <nav class="col" aria-label="Footer">
      <span class="label">Pages</span>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/book">Book</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 40px 0;
    background: var(--ink);
    color: var(--muted-dark);
    font-size: 16px;
  }

  .cols {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ground);
  }

  .wordmark span {
    color: var(--accent);
  }

  .label {
    font-weight: 600;
    color: var(--ground);
  }

  a {
    display: flex;
    align-items: center;
    min-height: 36px;
    color: var(--muted-dark);
  }

  a:hover {
    color: var(--ground);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding: 64px 0;
    }

    .cols {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px;
    }

    .col {
      gap: 10px;
    }

    .wordmark {
      font-size: 28px;
      letter-spacing: 1.5px;
    }

    a {
      min-height: 0;
    }
  }
</style>
