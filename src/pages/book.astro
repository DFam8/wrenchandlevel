---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Book">
  <PageHero eyebrow="Book" title="Book a time">
    <p class="lead">Pick a service, tell me about parts, then choose an evening or weekend slot.</p>
  </PageHero>

  <!-- Next step: Service and Parts steps (reading prices.json, ?service= preselects),
       then the prefilled Cal.com embed. See the build handoff's Booking section. -->
  <section class="section">
    <div class="container">
      <p class="body-lg">Online booking is coming soon.</p>
    </div>
  </section>
</Base>
