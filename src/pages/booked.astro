---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Booked">
  <PageHero eyebrow="All set" title="You're booked.">
    <p class="lead">
      A confirmation is on its way. Text photos of the job to the number in your confirmation so I come prepared.
    </p>
    <div class="btn-row">
      <a class="btn btn-accent" href="/">Back to home</a>
    </div>
  </PageHero>
</Base>
