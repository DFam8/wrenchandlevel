---
interface Props {
  size?: number;
}
const { size = 44 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <rect width="40" height="40" rx="8" fill="#2C2F33"></rect>
  <rect x="5" y="15" width="30" height="10" rx="2" fill="none" style="stroke: var(--accent)" stroke-width="2"></rect>
  <rect x="15" y="17.5" width="10" height="5" rx="2.5" fill="none" style="stroke: var(--ground)" stroke-width="1.5"></rect>
  <circle cx="20" cy="20" r="1.5" style="fill: var(--accent)"></circle>
</svg>
