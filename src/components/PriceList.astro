---
import prices from '../data/prices.json';

interface Props {
  category: 'home' | 'auto';
}
const { category } = Astro.props;
const services = prices.services.filter((s) => s.category === category);
---

<ul class="price-list">
  {services.map((s) => (
    <li>
      <strong>{s.name}</strong>
      <span class="price">{s.priceLabel}</span>
      {s.addOns.length > 0 && (
        <span class="addons">{s.addOns.map((a) => `${a.name} +$${a.price}`).join(' · ')}</span>
      )}
    </li>
  ))}
</ul>

<style>
  .price-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }

  li {
    display: grid;
    gap: 2px;
    padding: 16px;
    background: var(--white);
    border-radius: 6px;
  }

  .price {
    color: var(--gold);
    font-weight: 600;
  }

  .addons {
    font-size: 0.9375rem;
    opacity: 0.75;
  }
</style>
